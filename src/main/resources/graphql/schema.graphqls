scalar Instant
scalar Void

# Who may call what is in each description. "Anyone" works without a token and shows only what the viewer may see:
# visitors see published pages and public articles, and spexare by nickname only. USER, AUTHOR, EDITOR and ADMIN are
# client roles on fgv-spexipedia; AUTHOR, EDITOR and ADMIN are always given together with USER. SYNC is held by the
# service accounts of the applications that keep a copy of base data, REVIVAL by Nyuppsättning's.
#
# Base data (spex categories, spex, revivals, task categories, tasks, characters, numbers) is public: anyone reads it
# by id, published or not, retired included. "Published" applies to the public page only.

type Query {
    "Anyone with a token. The caller and their roles; null without a token."
    me: Me

    "Anyone. The start page: the spex of the year, this day in history, recent changes, the settings' text."
    startPage: StartPage!

    "Anyone. Every spex category, by first year; retired ones only with includeRetired."
    spexCategories(includeRetired: Boolean! = false): [SpexCategory!]!
    "Anyone. A spex category by id; also by the id of a category merged into it."
    spexCategory(id: ID!): SpexCategory
    "Anyone. Every spex, originals and revivals, by year then title; retired ones only with includeRetired. For other applications: copy what they need from here, then follow baseDataChanges."
    spexAll(includeRetired: Boolean! = false): [Spex!]!
    "Anyone. A spex by id or slug; also by the id of a spex merged into it."
    spex(id: ID!): Spex
    "Anyone. Spex whose title, year or category match, each original followed by its revivals, newest first. At most 50."
    spexSearch(q: String!, includeRetired: Boolean! = false): [Spex!]!
    "Anyone. The years that have spex, newest first, with how many."
    spexYears: [YearCount!]!
    "Anyone. Every task category with its tasks; retired ones only with includeRetired."
    taskCategories(includeRetired: Boolean! = false): [TaskCategory!]!
    "Anyone. A task category by id; also by the id of one merged into it."
    taskCategory(id: ID!): TaskCategory
    "Anyone. A task by id; also by the id of one merged into it."
    task(id: ID!): Task
    "Anyone. Every task, by category and name."
    tasks(includeRetired: Boolean! = false): [Task!]!

    "Anyone. A character by id."
    character(id: ID!): Character
    "Anyone. Characters by id, in the given order; unknown ids are left out. At most 500."
    charactersByIds(ids: [ID!]!): [Character!]!
    "Anyone. A number by id."
    number(id: ID!): Number
    "Anyone. Numbers by id, in the given order; unknown ids are left out. At most 500."
    numbersByIds(ids: [ID!]!): [Number!]!
    "Anyone. The kinds admins keep (spec 4.6) of a type, in order; use only for IMAGE kinds. Retired ones only with includeRetired."
    kinds(type: KindType!, use: KindUse, includeRetired: Boolean! = false): [Kind!]!
    "EDITOR. Credits that an import brought as names nobody has resolved yet (spec 5.3), oldest numbers first."
    unresolvedCredits(limit: Int! = 100): UnresolvedCredits!

    "Anyone. An article by id or slug that the viewer may see: published public ones for visitors; members' and unpublished ones for USER."
    article(id: ID!): Article
    "Anyone. Articles the viewer may see, by title, optionally in one category, and with includeSubcategories also in the categories below it."
    articles(categoryId: ID, includeSubcategories: Boolean! = false): [Article!]!
    "Anyone. The articles at the top of the tree (spec 4.5) that the viewer may see, in their order."
    articleRoots: [Article!]!
    "USER. Titles that articles link to but no article has, most linked first."
    wantedArticles(limit: Int! = 100): [WantedArticle!]!
    "USER. Articles nothing links to, without parent, children or category."
    orphanArticles: [Article!]!
    "Anyone. Every article category, by name, with the number of articles the viewer may see."
    articleCategories: [ArticleCategory!]!
    "Anyone. An article category by id or slug."
    articleCategory(id: ID!): ArticleCategory
    "USER. Every revision of articles and of spex page texts, newest first; hidden ones show only that they are hidden."
    recentChanges(page: Int! = 0, size: Int! = 50): RevisionPage!
    "Anyone. A revision the viewer may see: of an article the viewer may see, or of a published spex page's texts; authors only for AUTHOR."
    revision(id: ID!): Revision
    "Anyone. Where an old MediaWiki title leads: a path in the web, or null when no redirect matches."
    redirect(title: String!): String
    "ADMIN. Every redirect, by old title."
    redirects: [Redirect!]!

    "Anyone. Spex, characters, numbers, original songs and articles that match the words. People are never searched."
    search(q: String!, limit: Int! = 50): [SearchHit!]!
    "Anyone. Every public page, for the sitemap."
    sitemap: [SitemapEntry!]!

    "USER. Markdown rendered as the pages render it, [[links]] resolved, for the editor's preview."
    markdownPreview(markdown: String!): String!

    "USER. Published spexare in Spexregister matching a name, for picking credits."
    spexareSearch(q: String!): [Person!]!

    "AUTHOR. Albums of a spex in Spexgram that the caller may pick photos from, with their items."
    spexgramAlbums(spexId: ID!): [SpexgramAlbum!]!

    "SYNC. Changes to base data, characters and numbers, oldest first, after the cursor (null for the start). At most 500 a page; the caller's acknowledged cursor is remembered."
    baseDataChanges(after: String, first: Int = 500): BaseDataChangePage!

    "AUTHOR. Trashed articles and images, most recently trashed first."
    trash: Trash!
    "AUTHOR. The audit log, newest first: the caller's own changes, or everyone's for ADMIN, narrowed by the filter."
    auditLog(page: Int! = 0, size: Int! = 50, filter: AuditFilter): AuditPage!
    "AUTHOR. Who made the changes in the audit log the caller sees; only the caller unless ADMIN."
    auditActors: [AuditActor!]!
    "ADMIN."
    settings: Settings!
    "ADMIN. The consumers of the change feed, and how far each has read it."
    syncConsumers: [SyncConsumer!]!
    "ADMIN. The scheduled maintenance jobs, with their schedules and how their latest runs went."
    maintenanceJobs: [MaintenanceJobStatus!]!
}

type Mutation {
    "EDITOR. New categories start in use."
    spexCategoryCreate(input: SpexCategoryInput!): SpexCategory!
    "EDITOR."
    spexCategoryUpdate(id: ID!, input: SpexCategoryInput!): SpexCategory!
    "EDITOR. An uploaded image (imageId) or none."
    spexCategorySetLogo(id: ID!, imageId: ID): SpexCategory!
    "EDITOR. An original spex; its page starts unpublished."
    spexCreate(input: SpexInput!): Spex!
    "EDITOR. A revival takes its title and category from its parent and changes only its year."
    spexUpdate(id: ID!, input: SpexInput!): Spex!
    "EDITOR or REVIVAL. A revival of an original spex, in a year."
    spexRevivalCreate(parentId: ID!, year: String!): Spex!
    "EDITOR. An uploaded image (imageId) or none; a revival's poster is its own."
    spexSetPoster(id: ID!, imageId: ID): Spex!
    "EDITOR."
    taskCategoryCreate(input: TaskCategoryInput!): TaskCategory!
    "EDITOR."
    taskCategoryUpdate(id: ID!, input: TaskCategoryInput!): TaskCategory!
    "EDITOR."
    taskCreate(input: TaskInput!): Task!
    "EDITOR."
    taskUpdate(id: ID!, input: TaskInput!): Task!
    "ADMIN. A retired record stays readable but is not offered for new use; retired false brings it back."
    baseDataRetire(kind: BaseDataKind!, id: ID!, retired: Boolean!): Boolean!
    "ADMIN. Moves everything that refers to the record to another of the same kind, tells the consumers to do the same, and keeps the merged id as an alias."
    baseDataMerge(kind: BaseDataKind!, id: ID!, intoId: ID!): Boolean!

    "EDITOR. On an original spex, or on a revival for a character of its own."
    characterCreate(spexId: ID!, input: CharacterInput!): Character!
    "EDITOR."
    characterUpdate(id: ID!, input: CharacterInput!): Character!
    "EDITOR. Characters are base data: only one nothing refers to is deleted; retire the others."
    characterDelete(id: ID!): Boolean!
    "EDITOR. Characters as text, one per line (name, optionally ' – ' and a description), added after the existing ones."
    charactersPaste(spexId: ID!, text: String!): [Character!]!
    "EDITOR. The spex's own characters in the given order."
    charactersReorder(spexId: ID!, ids: [ID!]!): [Character!]!
    "AUTHOR. Images of a character: sketches, make-up sketches, costume dolls."
    characterSetImages(id: ID!, images: [ImageRefInput!]!): Character!
    "EDITOR."
    sceneCreate(spexId: ID!, input: SceneInput!): Scene!
    "EDITOR."
    sceneUpdate(id: ID!, input: SceneInput!): Scene!
    "EDITOR."
    sceneDelete(id: ID!): Boolean!
    "EDITOR. Scenes as text, one per line ('Title', 'Title – Place'; a line '--' marks an interval after the scene before; a line 'Akt 2' starts an act)."
    scenesPaste(spexId: ID!, text: String!): [Scene!]!
    "EDITOR. The spex's own scenes in the given order; act numbers come from the input."
    scenesReorder(spexId: ID!, items: [OrderInput!]!): [Scene!]!
    "EDITOR."
    numberCreate(spexId: ID!, input: NumberInput!): Number!
    "EDITOR."
    numberUpdate(id: ID!, input: NumberInput!): Number!
    "EDITOR. Numbers are base data: only one nothing refers to is deleted; retire the others."
    numberDelete(id: ID!): Boolean!
    "EDITOR. Resolves an unresolved credit (spec 5.3): the spexare it means (spexareId), or the name as someone outside FGV."
    creditResolve(numberId: ID!, kindId: ID!, position: Int!, credit: CreditInput!): Number!
    "EDITOR. Numbers as text, one per line ('Title', 'Title (Original song – Original artist)'; a line 'Akt 2' starts an act)."
    numbersPaste(spexId: ID!, text: String!): [Number!]!
    "EDITOR. The spex's own numbers in the given order; act numbers come from the input."
    numbersReorder(spexId: ID!, items: [OrderInput!]!): [Number!]!
    "EDITOR. For a revival: which of its parent's characters, scenes and numbers it cuts, and where it moves them."
    revivalSetChanges(revivalId: ID!, kind: RevivalChangeKind!, changes: [RevivalChangeInput!]!): Spex!


    "AUTHOR. The texts of a spex page; every changed text is a revision. Refused with CONFLICT when baseRevisionIds no longer match the texts' latest revisions."
    spexPageUpdate(spexId: ID!, input: SpexPageInput!): SpexPage!
    "AUTHOR. Images of a section of the page, in order, with captions: SCENOGRAPHY and OTHER per image kind of that use (the first when kindId is left out), VEST without a kind."
    spexPageSetImages(spexId: ID!, section: ImageSection!, kindId: ID, images: [ImageRefInput!]!): SpexPage!
    "AUTHOR. The facts of the spex (spec 4.2), at most one per fact kind; replaces the earlier ones. Empty values are left out."
    spexPageSetFacts(spexId: ID!, facts: [FactInput!]!): SpexPage!
    "AUTHOR. Photos from Spexgram for a section, in order: the group photo, the board, or an actor's photos (characterId)."
    spexPageSetPhotos(spexId: ID!, section: PhotoSection!, characterId: ID, itemIds: [ID!]!): SpexPage!
    "AUTHOR. The rebus and its solution, uploaded images, or none."
    spexPageSetRebus(spexId: ID!, rebusImageId: ID, solutionImageId: ID): SpexPage!
    "EDITOR."
    spexPageSetPublished(spexId: ID!, published: Boolean!): SpexPage!

    "USER. New articles start unpublished."
    articleCreate(input: ArticleInput!): Article!
    "USER. Refused with CONFLICT, with the newer revision, when baseRevisionId is not the article's latest revision."
    articleUpdate(id: ID!, input: ArticleInput!, baseRevisionId: ID): Article!
    "USER. The caller is editing the article, for a few minutes; others see who."
    articleEditing(id: ID!): Article!
    "USER. Restores an earlier revision as a new one."
    articleRestore(id: ID!, revisionId: ID!): Article!
    "AUTHOR."
    articleSetPublished(id: ID!, published: Boolean!): Article!
    "AUTHOR. Moves the article to the trash; restore with articleRestoreFromTrash. An article with children only withChildren, which trashes them too."
    articleTrash(id: ID!, withChildren: Boolean! = false): Boolean!
    "AUTHOR. Moves an article under another (parentId null for the top), last or at a position from 0; its children move with it."
    articleMove(id: ID!, parentId: ID, position: Int): Article!
    "AUTHOR. The children of an article (parentId null for the top) in the given order; all must be listed."
    articleReorderChildren(parentId: ID, ids: [ID!]!): [Article!]!
    "AUTHOR."
    articleRestoreFromTrash(id: ID!): Article!
    "AUTHOR. Hides or shows a revision's text; the revision is kept."
    revisionSetHidden(id: ID!, hidden: Boolean!): Revision!
    "USER."
    articleCategoryCreate(input: ArticleCategoryInput!): ArticleCategory!
    "AUTHOR."
    articleCategoryUpdate(id: ID!, input: ArticleCategoryInput!): ArticleCategory!

    "AUTHOR. The caption and text alternative of an uploaded image."
    imageUpdate(id: ID!, input: ImageInput!): Image!
    "AUTHOR."
    imageTrash(id: ID!): Boolean!
    "AUTHOR."
    imageRestore(id: ID!): Image!
    "ADMIN. Deletes everything in the trash for good."
    trashEmpty: Int!

    "ADMIN. A new kind (no id; type, and use for IMAGE kinds) or changes to one; type and use never change."
    kindSave(id: ID, input: KindInput!): Kind!
    "ADMIN. Every kind of a type and use, in the new order."
    kindsReorder(type: KindType!, use: KindUse, ids: [ID!]!): [Kind!]!
    "ADMIN. A retired kind stays on old records but is not offered for new ones; the last kind in use cannot be retired."
    kindRetire(id: ID!, retired: Boolean!): Kind!
    "ADMIN. Moves everything of a kind to another of the same type and use, keeps its names as aliases there, and deletes it."
    kindMerge(id: ID!, intoId: ID!): Kind!
    "ADMIN."
    redirectSave(input: RedirectInput!): Redirect!
    "ADMIN."
    redirectDelete(id: ID!): Boolean!
    "ADMIN."
    settingsUpdate(input: SettingsInput!): Settings!
    "ADMIN."
    syncConsumerSave(input: SyncConsumerInput!): SyncConsumer!
    "ADMIN."
    syncConsumerDelete(id: ID!): Boolean!
    "ADMIN. Starts a maintenance job now, unless it is already running; returns whether it was started."
    maintenanceJobRun(job: MaintenanceJob!): Boolean!
}

type Me {
    username: String!
    displayName: String
    email: String
    "Client roles on fgv-spexipedia."
    roles: [String!]!
}

type YearCount {
    year: String!
    count: Int!
}

type StartPage {
    "The settings' text, in the request's language."
    welcome: String
    "The spex of the year: the newest published original, else the newest published spex."
    spexOfTheYear: Spex
    "Published spex whose premiere was on today's date in earlier years."
    thisDay: [ThisDayEntry!]!
    "The latest revisions the viewer may see, newest first."
    recentChanges: [Revision!]!
    "Published spex pages by decade, oldest first."
    decades: [Decade!]!
}

type ThisDayEntry {
    "yyyy-mm-dd"
    date: String!
    text: String!
    spex: Spex
}

type Decade {
    "e.g. 1980"
    decade: Int!
    spex: [Spex!]!
}

enum BaseDataKind {
    SPEX_CATEGORY
    SPEX
    TASK_CATEGORY
    TASK
    CHARACTER
    NUMBER
}

type SpexCategory {
    id: ID!
    name: String!
    "yyyy"
    firstYear: String!
    description: String
    "The description as HTML, safe to show."
    descriptionHtml: String
    logo: Image
    retired: Boolean!
    "Its spex, originals first by year, then revivals."
    spex(includeRetired: Boolean! = false): [Spex!]!
    createdAt: Instant!
    lastModifiedAt: Instant
}

input SpexCategoryInput {
    name: String!
    firstYear: String!
    description: String
}

type Spex {
    id: ID!
    "For addresses: year and title, e.g. 1984-lasse-maja."
    slug: String!
    "yyyy"
    year: String!
    "A revival's is its parent's."
    title: String!
    "A revival's is its parent's."
    category: SpexCategory
    "The original, for a revival."
    parent: Spex
    revival: Boolean!
    "Revivals of an original, by year."
    revivals: [Spex!]!
    "The spex's own poster; a revival without one shows its parent's."
    poster: Image
    retired: Boolean!
    "The page; null for visitors while it is unpublished."
    page: SpexPage
    "Whether the page is published."
    published: Boolean!
    "The previous and next published spex of the category, originals only."
    previous: Spex
    next: Spex
    "Characters on the page: an original's own, a revival's after its changes. Retired ones only for EDITOR."
    characters: [Character!]!
    "Scenes on the page, by act and position."
    scenes: [Scene!]!
    "Numbers on the page, by act and position."
    numbers: [Number!]!
    "For a revival: its changes to its parent's characters, scenes and numbers."
    revivalChanges: [RevivalChange!]!
    "The records of the spex and its revivals (a revival's own only): Spexify's discography (spec 4.4), for everyone; empty when Spexify is unavailable. Oldest first."
    records: [Record!]!
    "The board and the tasks of the spex and its revivals, from Spexregister. Visitors see nicknames only."
    people: SpexPeople!
    "How much of the page is filled in, by section of the editing page; for AUTHOR, null for others. A revival is measured by what belongs to the production itself (poster, premiere, facts, photos), as it shows its original's content for the rest."
    completeness: Completeness
    "Links to the other applications that have something about the spex, for the viewer: Spexgram's public albums for everyone; the rest only for users with access to that application."
    links: [AppLink!]!
    createdAt: Instant!
    lastModifiedAt: Instant
}

input SpexInput {
    "yyyy"
    year: String!
    "Ignored for a revival."
    title: String
    "Ignored for a revival."
    categoryId: ID
}

type TaskCategory {
    id: ID!
    name: String!
    "Whether its tasks have a character and a vocal part."
    actorPresent: Boolean!
    "Whether its tasks are instruments, which Spexarkivet offers for the parts of arrangements."
    instruments: Boolean!
    retired: Boolean!
    tasks(includeRetired: Boolean! = false): [Task!]!
}

input TaskCategoryInput {
    name: String!
    actorPresent: Boolean!
    instruments: Boolean = false
}

type Task {
    id: ID!
    name: String!
    category: TaskCategory
    "Whether it is a task of the direktion, shown as such on spex pages."
    board: Boolean!
    retired: Boolean!
}

input TaskInput {
    name: String!
    categoryId: ID!
    board: Boolean = false
}

type Character {
    id: ID!
    "The spex the character belongs to: an original, or a revival that added it."
    spex: Spex!
    name: String!
    description: String
    "The description as HTML, safe to show."
    descriptionHtml: String
    position: Int!
    retired: Boolean!
    images: [PageImage!]!
    "Who played the character in the spex and each of its revivals, from Spexregister. Visitors see nicknames only."
    playedBy: [PlayedBy!]!
    "Photos of the actors from Spexgram: none for visitors; public ones for logged-in users, members' ones for users with access to Spexgram."
    photos: PhotoSet!
    "Numbers the character sings."
    numbers: [Number!]!
}

input CharacterInput {
    name: String!
    description: String
}

type Scene {
    id: ID!
    spex: Spex!
    act: Int!
    position: Int!
    title: String!
    place: String
    "Whether there is an interval after the scene."
    intervalAfter: Boolean!
}

input SceneInput {
    act: Int!
    title: String!
    place: String
    intervalAfter: Boolean!
}

input OrderInput {
    id: ID!
    act: Int!
}

type Number {
    id: ID!
    spex: Spex!
    act: Int!
    position: Int!
    title: String!
    "A number kind (spec 4.6)."
    kind: Kind
    originalTitle: String
    originalArtist: String
    "Where the original song is from, e.g. a musical or a film."
    fromWork: String
    "The first line of the lyrics."
    firstLine: String
    "Credits by credit kind, in the kinds' order; unresolved ones only for EDITOR."
    credits: [NumberCredit!]!
    characters: [Character!]!
    retired: Boolean!
    "Links for the viewer: the track in Spexify, the arrangement in Spexarkivet."
    links: [AppLink!]!
    "The books the number is in: Spexarkivet's published books (spec 4.4), for everyone; empty when the archive is unavailable."
    books: [NumberBook!]!
}

input NumberInput {
    act: Int!
    title: String!
    kindId: ID
    originalTitle: String
    originalArtist: String
    fromWork: String
    firstLine: String
    "Replaces all of the number's credits when given."
    credits: [NumberCreditInput!]
    characterIds: [ID!]
}

type NumberCredit {
    kind: Kind!
    "The credit's place among the number's credits of its kind, from 0."
    position: Int!
    credit: Credit!
}

input NumberCreditInput {
    "A credit kind."
    kindId: ID!
    spexareId: ID
    "Only for people outside FGV."
    name: String
    "Keeps an unresolved credit (spec 5.3) as it is, with its imported name, when the credits are saved again; resolve it with creditResolve."
    unresolved: Boolean = false
}

type UnresolvedCredits {
    total: Int!
    credits: [UnresolvedCredit!]!
}

type UnresolvedCredit {
    number: Number!
    kind: Kind
    position: Int!
    "The name as imported. Never shown on pages."
    name: String!
}

"""
Who wrote, composed, arranged or choreographed something, or conducted a recording: a spexare in Spexregister (shown
as section 5.3 of the spec says; nothing when the spexare is not published) or a person outside FGV, by name.
"""
type Credit {
    person: Person
    "For people outside FGV; for an unresolved credit, the imported name."
    name: String
    "An imported name nobody has resolved yet; only editors see these (spec 5.3)."
    unresolved: Boolean!
}

input CreditInput {
    spexareId: ID
    "Only for people outside FGV; editors refer to spexare instead."
    name: String
}

enum RevivalChangeKind {
    CHARACTER
    SCENE
    NUMBER
}

type RevivalChange {
    kind: RevivalChangeKind!
    "The parent's record."
    recordId: ID!
    cut: Boolean!
    act: Int
    position: Int
}

input RevivalChangeInput {
    recordId: ID!
    cut: Boolean!
    act: Int
    position: Int
}

enum KindType {
    NUMBER
    CREDIT
    IMAGE
    FACT
}

"Where image kinds are used; other types of kinds have none."
enum KindUse {
    CHARACTER
    SCENOGRAPHY
    PAGE
}

enum FactValueType {
    TEXT
    "yyyy, yyyy-mm or yyyy-mm-dd"
    DATE
}

"A kind admins keep (spec 4.6). The import recognises it by its names and aliases."
type Kind {
    id: ID!
    type: KindType!
    use: KindUse
    "For fact kinds."
    valueType: FactValueType
    "In the request's language."
    name: String!
    nameSv: String!
    nameEn: String!
    aliases: [String!]!
    position: Int!
    retired: Boolean!
}

input KindInput {
    "For a new kind only."
    type: KindType
    "For a new image kind only."
    use: KindUse
    "For fact kinds; TEXT when left out."
    valueType: FactValueType
    nameSv: String!
    nameEn: String!
    aliases: [String!]
}

"""
A record of a spex: an album of Spexify's discography (spec 4.4), edited in Spexify. url leads there for users with
access to Spexify; the covers are links Spexify signs for some hours.
"""
type Record {
    id: ID!
    title: String!
    year: Int
    kindNameSv: String!
    kindNameEn: String!
    "LP, EP, CD, digital …; null for an album that was never released."
    mediumNameSv: String
    mediumNameEn: String
    "e.g. CEP 019"
    catalogueNumber: String
    "yyyy, yyyy-mm or yyyy-mm-dd"
    released: String
    recorded: String
    conductor: String
    "The spex or revival it is a recording of."
    spexId: ID
    coverUrl: String
    backCoverUrl: String
    "In Spexify, for users with access there."
    url: String
    tracks: [RecordTrack!]!
}

type RecordTrack {
    id: ID!
    "e.g. A or B, for records with sides."
    side: String
    discNumber: Int!
    position: Int!
    title: String!
    "The number it is a recording of."
    number: Number
    "Whether it can be listened to in Spexify."
    hasAudio: Boolean!
    "Plays it in Spexify, for users with access there."
    url: String
}

"A book a number is in: a book of Spexarkivet (spec 4.4), edited there."
type NumberBook {
    id: ID!
    title: String!
    "Its number in its series: 1 for Chalmersspex I."
    volume: Int
    "yyyy, yyyy-mm or yyyy-mm-dd"
    publishedYear: String
    kindNameSv: String!
    kindNameEn: String!
    "The song's place in the book, from 1."
    position: Int!
    "Whether the book has only the words."
    textOnly: Boolean!
    "In Spexarkivet, for users with access there."
    url: String
}

type SpexPage {
    spex: Spex!
    "yyyy-mm-dd"
    premiere: String
    "Short, for tiles and previews."
    introduction: String
    "A sentence or two, for lists and the head of the page."
    shortDescription: String
    "Markdown."
    description: String
    "The description as HTML, safe to show."
    descriptionHtml: String
    "Markdown."
    synopsis: String
    "The synopsis as HTML, safe to show."
    synopsisHtml: String
    "The ids of the latest revisions of introduction, description and synopsis, to pass back when saving."
    revisionIds: SpexPageRevisionIds!
    rebus: Image
    "Hidden behind 'Show solution'."
    rebusSolution: Image
    "Markdown."
    vestDescription: String
    "The vest's description as HTML, safe to show."
    vestDescriptionHtml: String
    "Who wore the vest."
    vestWornBy: Credit
    "The images of a section: for SCENOGRAPHY and OTHER in the order of their kinds; a revival without its own shows its parent's."
    images(section: ImageSection!): [PageImage!]!
    "Facts in the order of their kinds (spec 4.2); a revival without its own shows its parent's."
    facts: [Fact!]!
    "Photos from Spexgram of a section: GROUP or BOARD."
    photos(section: PhotoSection!): PhotoSet!
    published: Boolean!
    "USER. Who changed the texts and when, newest first; who wrote them only for AUTHOR."
    history: [Revision!]!
    lastModifiedAt: Instant
}

type SpexPageRevisionIds {
    introduction: ID
    description: ID
    synopsis: ID
}

input SpexPageInput {
    premiere: String
    introduction: String
    shortDescription: String
    description: String
    synopsis: String
    vestDescription: String
    vestWornBy: CreditInput
    baseRevisionIds: SpexPageRevisionIdsInput
}

input SpexPageRevisionIdsInput {
    introduction: ID
    description: ID
    synopsis: ID
}

"How much of a spex's page is filled in: every item weighs the same, and the share is of all items."
type Completeness {
    "0 to 1."
    share: Float!
    sections: [CompletenessSection!]!
}

type CompletenessSection {
    section: CompletenessSectionName!
    "0 to 1: the share of the section's items."
    share: Float!
    items: [CompletenessItem!]!
}

type CompletenessItem {
    item: CompletenessItemName!
    "0 to 1: 1 when filled in; for a list, the share of its rows that have it (characters with a description, numbers with credits)."
    filled: Float!
}

"The sections of the spex's editing page. FACTS is left out when no fact kind is in use."
enum CompletenessSectionName {
    BASE
    TEXTS
    FACTS
    MEDIA
    CHARACTERS
    SCENES
    NUMBERS
}

"What a spex page can have. FACTS is the share of the fact kinds in use that have a value."
enum CompletenessItemName {
    POSTER
    PREMIERE
    INTRODUCTION
    SHORT_DESCRIPTION
    DESCRIPTION
    SYNOPSIS
    VEST_DESCRIPTION
    VEST_WORN_BY
    FACTS
    SCENOGRAPHY
    VEST
    REBUS
    REBUS_SOLUTION
    GROUP_PHOTOS
    BOARD_PHOTOS
    CHARACTERS
    CHARACTER_DESCRIPTIONS
    CHARACTER_IMAGES
    SCENES
    SCENE_PLACES
    NUMBERS
    NUMBER_ORIGINALS
    NUMBER_CREDITS
    NUMBER_CHARACTERS
}

enum ImageSection {
    "Grouped by image kinds for scenography."
    SCENOGRAPHY
    "Without kinds."
    VEST
    "Grouped by image kinds for the page."
    OTHER
}

type Fact {
    kind: Kind!
    value: String!
}

input FactInput {
    "A fact kind."
    kindId: ID!
    value: String
}

enum PhotoSection {
    GROUP
    BOARD
    ACTOR
}

enum ImageKind {
    POSTER
    LOGO
    SKETCH
    MAKEUP
    COSTUME
    SCENOGRAPHY
    REBUS
    VEST
    COVER
    ARTICLE
    OTHER
}

type Image {
    id: ID!
    kind: ImageKind!
    caption: String
    "The text alternative; the caption when there is none."
    alt: String!
    width: Int!
    height: Int!
    "Addresses under /media/: about 320, 1280 and 2560 pixels wide (never wider than the original)."
    thumbnailUrl: String!
    pageUrl: String!
    fullUrl: String!
    "The same sizes as JPEG, for previews elsewhere."
    pageJpegUrl: String!
    "AUTHOR."
    originalFileName: String
    trashedAt: Instant
}

input ImageInput {
    caption: String
    alt: String
}

"An image on a page, with the caption it has there."
type PageImage {
    image: Image!
    "The image kind of the group it is in; null for the vest."
    kind: Kind
    caption: String
}

input ImageRefInput {
    imageId: ID!
    "For a character's images: an image kind for characters, the first when left out."
    kindId: ID
    caption: String
}

"""
Photos and short videos from Spexgram. They show people, so visitors get none, even of the public ones, and are not told of
them. Logged-in users see the public ones; members' ones only users with access to Spexgram, and they are counted for other
logged-in users, who see placeholders.
"""
type PhotoSet {
    photos: [Photo!]!
    "Members' photos the viewer may not see."
    hiddenCount: Int!
    "Whether Spexgram could be reached."
    available: Boolean!
    "AUTHOR. The chosen item ids, in order."
    itemIds: [ID!]!
}

type Photo {
    itemId: ID!
    caption: String
    thumbnailUrl: String!
    previewUrl: String!
    width: Int
    height: Int
    "The item's page in Spexgram."
    url: String!
    public: Boolean!
    "A short video: videoUrl plays it, previewUrl is its poster frame."
    video: Boolean!
    "Spexgram's signed address of the video, for the browser; null for photos."
    videoUrl: String
}

type SpexgramAlbum {
    id: ID!
    title: String!
    url: String!
    items: [Photo!]!
}

"""
A spexare from Spexregister, as the viewer may see them: visitors get the nickname only (and nothing for someone without
one), logged-in users the name too. Unpublished spexare are never shown.
"""
type Person {
    "USER."
    id: ID
    nickname: String
    "USER."
    name: String
    "The spexare's page in Spexregister, for users with access to it."
    url: String
}

type PlayedBy {
    person: Person!
    "The production: the spex or one of its revivals."
    spex: Spex!
}

type SpexPeople {
    "Whether Spexregister could be reached; when not, the page says so."
    available: Boolean!
    "The tasks of the direktion, per production."
    board: [TaskHolders!]!
    "Every other task, per production and category."
    tasks: [TaskHolders!]!
    "Photos of the board from Spexgram."
    boardPhotos: PhotoSet!
}

type TaskHolders {
    "The production: the spex or one of its revivals."
    spex: Spex!
    task: Task!
    people: [Person!]!
}

enum AppLinkKind {
    SPEXREGISTER
    SPEXIFY_ALBUM
    SPEXIFY_TRACK
    SPEXFLIX_VIDEO
    ARCHIVE_MANUSCRIPT
    ARCHIVE_ARRANGEMENT
    SPEXGRAM_ALBUM
}

type AppLink {
    kind: AppLinkKind!
    title: String!
    url: String!
}

enum Visibility {
    PUBLIC
    MEMBERS
}

type Article {
    id: ID!
    slug: String!
    title: String!
    "Markdown; null when the viewer may not see the latest revision's text."
    body: String
    "The body as HTML, with [[links]] resolved."
    html: String
    visibility: Visibility!
    published: Boolean!
    categories: [ArticleCategory!]!
    "The latest revision."
    revision: Revision
    "USER. Revisions, newest first."
    history: [Revision!]!
    "USER. Who else is editing it now."
    editingBy: [String!]!
    trashedAt: Instant
    createdAt: Instant!
    lastModifiedAt: Instant
    "The parent in the tree of articles (spec 4.5); null at the top or when the viewer may not see it."
    parent: Article
    "From the top down to the parent, for breadcrumbs."
    ancestors: [Article!]!
    "The children the viewer may see, in their order."
    children: [Article!]!
    "The parent's children (or the articles at the top), this one included, for the tree beside the article."
    siblings: [Article!]!
    "The articles the viewer may see that link here."
    backlinks: [Article!]!
    "The headings of the article, for a table of contents; empty with fewer than three."
    toc: [Heading!]!
}

type Heading {
    level: Int!
    "The heading's id in the html."
    anchor: String!
    text: String!
}

type WantedArticle {
    title: String!
    "How many articles link to it."
    links: Int!
}

input ArticleInput {
    title: String!
    body: String!
    visibility: Visibility!
    categoryIds: [ID!]
    "What changed, for the history."
    comment: String
    "For a new article: its parent; move existing ones with articleMove."
    parentId: ID
}

type ArticleCategory {
    id: ID!
    slug: String!
    name: String!
    description: String
    articleCount: Int!
    "The categories it belongs to."
    parents: [ArticleCategory!]!
    "The categories directly below it."
    subcategories: [ArticleCategory!]!
}

input ArticleCategoryInput {
    name: String!
    description: String
    "Null leaves the parents as they are."
    parentIds: [ID!]
}

enum RevisionTarget {
    ARTICLE
    SPEX_PAGE
}

type Revision {
    id: ID!
    target: RevisionTarget!
    "The article, or the spex page's spex id."
    targetId: ID!
    "The title of the article or spex at the time."
    targetTitle: String!
    "For a spex page: INTRODUCTION, DESCRIPTION or SYNOPSIS."
    field: String
    "Null when hidden, unless the viewer is AUTHOR."
    body: String
    "The revision before, to compare with."
    previousId: ID
    comment: String
    hidden: Boolean!
    "AUTHOR."
    authorName: String
    createdAt: Instant!
}

type RevisionPage {
    entries: [Revision!]!
    totalCount: Int!
    page: Int!
    size: Int!
}

type Redirect {
    id: ID!
    "As in the MediaWiki, e.g. 'Alexander - CEP 019'."
    oldTitle: String!
    "A path in the web, e.g. /spex/1984-lasse-maja."
    target: String!
}

input RedirectInput {
    id: ID
    oldTitle: String!
    target: String!
}

enum SearchKind {
    SPEX
    CHARACTER
    NUMBER
    ARTICLE
}

type SearchHit {
    kind: SearchKind!
    id: ID!
    title: String!
    "e.g. the spex and year of a character."
    context: String
    "A path in the web."
    path: String!
}

type SitemapEntry {
    path: String!
    lastModifiedAt: Instant
}

enum ChangeType {
    UPSERT
    RETIRE
    MERGE
}

type BaseDataChangePage {
    changes: [BaseDataChange!]!
    "Pass as after for the next page; the same as after when there was nothing new."
    cursor: String
    hasMore: Boolean!
}

"""
One change. The record is as it was right after the change, so that applying the changes in order gives the same copy
whenever it is read.
"""
type BaseDataChange {
    sequence: String!
    kind: BaseDataKind!
    id: ID!
    change: ChangeType!
    "For MERGE: the record it was merged into; move references from id to it."
    mergedIntoId: ID
    at: Instant!
    spexCategory: FeedSpexCategory
    spex: FeedSpex
    taskCategory: FeedTaskCategory
    task: FeedTask
    character: FeedCharacter
    number: FeedNumber
}

type FeedSpexCategory {
    id: ID!
    name: String!
    firstYear: String!
    logoUrl: String
    retired: Boolean!
}

type FeedSpex {
    id: ID!
    year: String!
    "A revival's is its parent's."
    title: String!
    categoryId: ID
    parentId: ID
    posterUrl: String
    retired: Boolean!
}

type FeedTaskCategory {
    id: ID!
    name: String!
    actorPresent: Boolean!
    instruments: Boolean!
    retired: Boolean!
}

type FeedTask {
    id: ID!
    name: String!
    categoryId: ID
    board: Boolean!
    retired: Boolean!
}

type FeedCharacter {
    id: ID!
    spexId: ID!
    name: String!
    position: Int!
    retired: Boolean!
}

type FeedNumber {
    id: ID!
    spexId: ID!
    act: Int!
    position: Int!
    title: String!
    originalTitle: String
    originalArtist: String
    retired: Boolean!
}

type SyncConsumer {
    id: ID!
    name: String!
    "The consumer's service account (azp), which acknowledges by reading the feed."
    clientId: String!
    "POST with Spexipedia's service token after each change; null to rely on the consumer's own pulls."
    notifyUrl: String
    enabled: Boolean!
    "The last sequence the consumer read up to."
    acknowledged: String
    acknowledgedAt: Instant
    "How many changes it has not read."
    lag: Int!
    lastNotifiedAt: Instant
    lastError: String
}

input SyncConsumerInput {
    id: ID
    name: String!
    clientId: String!
    notifyUrl: String
    enabled: Boolean!
}

type Trash {
    articles: [Article!]!
    images: [Image!]!
}

type Settings {
    welcomeSv: String
    welcomeEn: String
    publicWelcomeSv: String
    publicWelcomeEn: String
    contactEmail: String
    lastModifiedAt: Instant
}

input SettingsInput {
    welcomeSv: String
    welcomeEn: String
    publicWelcomeSv: String
    publicWelcomeEn: String
    contactEmail: String
}

type AuditPage {
    entries: [AuditLogEntry!]!
    totalCount: Int!
    page: Int!
    size: Int!
}

type AuditLogEntry {
    id: ID!
    at: Instant!
    "Who made the change, by their subject."
    actorId: String!
    actorName: String
    action: String!
    "SPEX, SPEX_CATEGORY, TASK, CHARACTER, NUMBER, ARTICLE, IMAGE, SETTINGS and so on."
    entityType: String!
    entityId: ID
    summary: String!
}

"What to show of the audit log; every field is optional."
input AuditFilter {
    entityType: String
    action: String
    "Only ADMIN sees others' changes."
    actorId: String
    from: Instant
    to: Instant
    q: String
    entityId: ID
}

type AuditActor {
    id: String!
    name: String
}

"""
A scheduled maintenance job: making missing image variants (IMAGE_VARIANTS), checking the links to the other
applications (LINK_CHECK), rebuilding the search index (SEARCH_REBUILD), sending notifications that failed
(SYNC_NOTIFY), removing unfinished uploads (UPLOAD_CLEANUP) and deleting people past their retention (RETENTION).
"""
enum MaintenanceJob {
    IMAGE_VARIANTS
    LINK_CHECK
    SEARCH_REBUILD
    SYNC_NOTIFY
    UPLOAD_CLEANUP
    RETENTION
}

"A maintenance job and how its latest run went. Runs are remembered until the server restarts."
type MaintenanceJobStatus {
    job: MaintenanceJob!
    "The job's cron expression, in the server's time zone, or null when it is not scheduled."
    schedule: String
    running: Boolean!
    lastStartedAt: Instant
    lastFinishedAt: Instant
    "Whether the latest run finished without an error; null while it runs."
    lastSucceeded: Boolean
}

# The import API (spec 5.11; docs/content-import.md, section 4) ---------------------------------------------------------
# IMPORT only: the service accounts of fgv-content-migration and of Spexipedia's spex packages. Files are uploaded first
# to PUT /api/import/files/{sha256} and referred to by their hash. Kinds are given by name or alias.

extend type Mutation {
    "IMPORT. Imports records: new source keys create, known ones update what they made unless an editor has changed it since. With dryRun nothing is kept. At most 500 records."
    importBatch(input: ImportBatchInput!, dryRun: Boolean! = false): ImportResult!
    "IMPORT. Removes what was imported under the source prefix and is still unpublished and unchanged; returns how many."
    importForget(sourcePrefix: String!): Int!
}

input ImportBatchInput {
    "Whether kind names nobody knows become new kinds, instead of failing the record."
    createMissingKinds: Boolean = false
    spex: [ImportSpexInput!]
    pages: [ImportPageInput!]
    characters: [ImportCharacterInput!]
    scenes: [ImportSceneInput!]
    numbers: [ImportNumberInput!]
    articleCategories: [ImportArticleCategoryInput!]
    articles: [ImportArticleInput!]
    redirects: [ImportRedirectInput!]
}

input ImportFileInput {
    sha256: String!
    "The name to show, e.g. the file's original name."
    name: String
}

"A spex matched by id, or created (spex packages); a revival gives its parent by id or source key."
input ImportSpexInput {
    sourceKey: String!
    id: ID
    title: String
    year: String!
    "A spex category by name."
    category: String
    parentId: ID
    parentSourceKey: String
    poster: ImportFileInput
}

"A spex page; fields left out are left as they are. The spex by id or by the source key of an ImportSpexInput."
input ImportPageInput {
    sourceKey: String!
    spexId: ID
    spexSourceKey: String
    "yyyy-mm-dd"
    premiere: String
    introduction: String
    shortDescription: String
    description: String
    synopsis: String
    vestDescription: String
    poster: ImportFileInput
    rebus: ImportFileInput
    rebusSolution: ImportFileInput
    "Replaces the page's facts when given."
    facts: [ImportFactInput!]
    "Replaces the images of the sections and kinds given."
    images: [ImportPageImageInput!]
}

input ImportFactInput {
    "A fact kind by name or alias."
    kind: String!
    value: String
}

input ImportPageImageInput {
    "SCENOGRAPHY, VEST or OTHER."
    section: String!
    "An image kind of the section's use; the first when left out."
    kind: String
    file: ImportFileInput!
    caption: String
}

input ImportCharacterInput {
    sourceKey: String!
    spexId: ID
    spexSourceKey: String
    name: String!
    description: String
    position: Int
    images: [ImportCharacterImageInput!]
}

input ImportCharacterImageInput {
    "An image kind for characters; the first when left out."
    kind: String
    file: ImportFileInput!
    caption: String
}

input ImportSceneInput {
    sourceKey: String!
    spexId: ID
    spexSourceKey: String
    act: Int
    position: Int
    title: String!
    place: String
    intervalAfter: Boolean
}

input ImportNumberInput {
    sourceKey: String!
    spexId: ID
    spexSourceKey: String
    act: Int
    position: Int
    title: String!
    "A number kind by name or alias."
    kind: String
    originalTitle: String
    originalArtist: String
    fromWork: String
    firstLine: String
    "Replaces the number's credits when given."
    credits: [ImportCreditInput!]
    "Names of the spex's characters who sing it."
    characters: [String!]
}

"A credit by name: exactly one published spexare with the name becomes a reference to them; else someone outside FGV with outsideFgv, else an unresolved credit for editors (spec 5.3)."
input ImportCreditInput {
    "A credit kind by name or alias."
    kind: String!
    name: String!
    outsideFgv: Boolean
}

input ImportArticleCategoryInput {
    sourceKey: String!
    name: String!
    description: String
    "Parent categories by name, created when missing."
    parents: [String!]
}

"An article. The body refers to its images as ![caption](import:<key>)."
input ImportArticleInput {
    sourceKey: String!
    title: String!
    body: String!
    "PUBLIC or MEMBERS; PUBLIC when left out."
    visibility: String
    "Categories by name, created when missing."
    categories: [String!]
    parentSourceKey: String
    images: [ImportArticleImageInput!]
}

input ImportArticleImageInput {
    key: String!
    file: ImportFileInput!
    caption: String
}

"An old title and where it leads: a path, or the page of a record imported with targetSourceKey."
input ImportRedirectInput {
    sourceKey: String!
    oldTitle: String!
    target: String
    targetSourceKey: String
}

type ImportResult {
    dryRun: Boolean!
    items: [ImportItem!]!
    created: Int!
    updated: Int!
    unchanged: Int!
    kept: Int!
    failed: Int!
}

type ImportItem {
    kind: String!
    sourceKey: String!
    id: ID
    outcome: ImportOutcome!
    message: String
    warnings: [String!]!
}

enum ImportOutcome {
    CREATED
    UPDATED
    UNCHANGED
    "An editor changed or removed the record since it was imported, so the import left it alone."
    KEPT
    FAILED
}

# Spex packages (spec 5.14) ------------------------------------------------------------------------------------------
# The template, the spreadsheet and the zip go over REST: GET /api/packages/template.xlsx, POST /api/packages
# (multipart: spreadsheet, zipFileName, zipSize), then the zip in parts: HEAD /api/packages/{id}/zip answers
# Upload-Offset, PATCH /api/packages/{id}/zip with Upload-Offset appends a part.

extend type Query {
    "EDITOR. Every spex package, newest first."
    spexPackages: [SpexPackage!]!
    "EDITOR. A spex package."
    spexPackage(id: ID!): SpexPackage
}

extend type Mutation {
    "EDITOR. Starts the preview: dry runs in every application, in the background (poll the package's state)."
    spexPackagePreview(id: ID!): SpexPackage!
    "EDITOR. Starts applying the package: Spexipedia first, then the other applications. Safe to do again."
    spexPackageApply(id: ID!): SpexPackage!
    "EDITOR. Deletes the package and its files; not while it runs. What it created stays."
    spexPackageDelete(id: ID!): Void
}

enum SpexPackageState {
    UPLOADED
    PREVIEWING
    PREVIEWED
    APPLYING
    APPLIED
    FAILED
}

type SpexPackage {
    id: ID!
    state: SpexPackageState!
    fileName: String!
    zipFileName: String
    "The zip's size in bytes, null without a zip; zipReceived how much of it has arrived."
    zipSize: Float
    zipReceived: Float!
    "The spex the package created or added to, once known."
    spex: Spex
    "0–100 while a preview or apply runs, and what it does now; why it failed."
    progress: Int!
    message: String
    preview: SpexPackageReport
    results: SpexPackageReport
    uploadedByName: String
    createdAt: Instant!
    appliedAt: Instant
}

type SpexPackageReport {
    "Per application, Spexipedia first."
    apps: [SpexPackageApp!]!
    "Files and rows that go nowhere, and why."
    unmatched: [String!]!
    warnings: [String!]!
}

type SpexPackageApp {
    "SPEXIPEDIA, ARCHIVE, SPEXIFY, SPEXFLIX or SPEXGRAM."
    app: String!
    "CHECKED (dry run), APPLIED, DEFERRED (checked when applied: it needs the new spex), UNAVAILABLE or FAILED."
    status: String!
    records: Int!
    files: Int!
    created: Int!
    updated: Int!
    unchanged: Int!
    kept: Int!
    failed: Int!
    message: String
    "The application's web, for links to what was created."
    webUrl: String
    items: [SpexPackageItem!]!
}

type SpexPackageItem {
    kind: String!
    sourceKey: String!
    id: ID
    outcome: String!
    message: String
    warnings: [String!]!
}
