    ARCHIVE_DOCUMENT
    "Everything an application has about the spex, on its page there."
    SPEXIFY_SPEX
    SPEXFLIX_SPEX
    SPEXGRAM_SPEX
    ARCHIVE_SPEX
}

"""
A link to material in another FGV application, for users with access there (a public Spexgram album for everyone).
"""
type AppLink {
    kind: AppLinkKind!
    title: String!
    url: String!
    "More about it, in the request's language: a document's kind, a chapter's video."
    detail: String
}

enum Visibility {
    PUBLIC
    MEMBERS
}

type Article {
    id: ID!
    slug: String!
    title: String!
    "Markdown; null when the viewer may not see the latest revision's text."
    body: String
    "The body as HTML, with [[links]] resolved."
    html: String
    visibility: Visibility!
    published: Boolean!
    categories: [ArticleCategory!]!
    "The latest revision."
    revision: Revision
    "USER. Revisions, newest first."
    history: [Revision!]!
    "USER. Who else is editing it now."
    editingBy: [String!]!
    trashedAt: Instant
    createdAt: Instant!
    lastModifiedAt: Instant
    "The parent in the tree of articles (spec 4.5); null at the top or when the viewer may not see it."
    parent: Article
    "From the top down to the parent, for breadcrumbs."
    ancestors: [Article!]!
    "The children the viewer may see, in their order."
    children: [Article!]!
    "The parent's children (or the articles at the top), this one included, for the tree beside the article."
    siblings: [Article!]!
    "The articles the viewer may see that link here."
    backlinks: [Article!]!
    "The headings of the article, for a table of contents; empty with fewer than three."
    toc: [Heading!]!
}

type Heading {
    level: Int!
    "The heading's id in the html."
    anchor: String!
    text: String!
}

type WantedArticle {
