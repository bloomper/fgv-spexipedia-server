    "The title of the article or spex at the time."
    targetTitle: String!
    "For a spex page: INTRODUCTION, DESCRIPTION or SYNOPSIS."
    field: String
    "Null when hidden, unless the viewer is AUTHOR."
    body: String
    "The revision before, to compare with."
    previousId: ID
    comment: String
    hidden: Boolean!
    "AUTHOR."
    authorName: String
    createdAt: Instant!
}

type RevisionPage {
    entries: [Revision!]!
    totalCount: Int!
    page: Int!
    size: Int!
}

type Redirect {
