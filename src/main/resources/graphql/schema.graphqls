    categoryId: ID
    parentId: ID
    posterUrl: String
    retired: Boolean!
}

type FeedTaskCategory {
    id: ID!
    name: String!
    actorPresent: Boolean!
    instruments: Boolean!
    retired: Boolean!
}

type FeedTask {
    id: ID!
    name: String!
    categoryId: ID
    board: Boolean!
    retired: Boolean!
}

type FeedCharacter {
    id: ID!
    spexId: ID!
