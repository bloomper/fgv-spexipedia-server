enum AppLinkKind {
    SPEXREGISTER
    SPEXIFY_ALBUM
    SPEXIFY_TRACK
    SPEXFLIX_VIDEO
    ARCHIVE_MANUSCRIPT
    ARCHIVE_ARRANGEMENT
