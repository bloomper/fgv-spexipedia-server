    BASE
    TEXTS
    FACTS
    MEDIA
    CHARACTERS
    SCENES
    NUMBERS
}

"What a spex page can have. FACTS is the share of the fact kinds in use that have a value."
enum CompletenessItemName {
    POSTER
    PREMIERE
    INTRODUCTION
    SHORT_DESCRIPTION
    DESCRIPTION
    SYNOPSIS
    VEST_DESCRIPTION
    VEST_WORN_BY
    FACTS
    "Images in the image sections."
    IMAGES
    VEST
    REBUS
    REBUS_SOLUTION
    GROUP_PHOTOS
    BOARD_PHOTOS
    CHARACTERS
    CHARACTER_DESCRIPTIONS
    CHARACTER_IMAGES
    SCENES
    SCENE_PLACES
    NUMBERS
    NUMBER_ORIGINALS
    NUMBER_CREDITS
    NUMBER_CHARACTERS
}

