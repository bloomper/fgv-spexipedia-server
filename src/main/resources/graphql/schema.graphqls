    mediumNameEn: String
    "e.g. CEP 019"
    catalogueNumber: String
    "yyyy, yyyy-mm or yyyy-mm-dd"
    released: String
    recorded: String
    conductor: String
    "The spex or revival it is a recording of."
    spexId: ID
    coverUrl: String
    backCoverUrl: String
    "In Spexify, for users with access there."
    url: String
    tracks: [RecordTrack!]!
}

type RecordTrack {
